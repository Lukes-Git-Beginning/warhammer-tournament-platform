# =============================================================================
# Template for /etc/rizzotto/env/backend.env on the production server.
# Copy this file there, fill in real secrets, and chmod 0640 owned by root:deploy.
# Never commit the populated version.
# =============================================================================

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
# pg_password.txt contents go inline here (Docker secret is for the container only).
DATABASE_URL=postgresql://rizzotto:REPLACE_WITH_PG_PASSWORD@127.0.0.1:5432/rizzotto?schema=public

# ---- Redis ----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth (JWT) -----------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_48_RANDOM_BASE64_CHARS
JWT_COOKIE_NAME=auth_token
JWT_COOKIE_DOMAIN=rizzotto.gg
JWT_EXPIRES_IN=604800

# ---- Discord OAuth2 -------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://rizzotto.gg/auth/discord/callback
DISCORD_SCOPES="identify email"

# ---- Discord Bot (optional, Notifications) --------------------------------
# Leave blank for now — Discord notifications are silent no-op when unset.
DISCORD_BOT_TOKEN=

# ---- Steam OpenID 2.0 -----------------------------------------------------
STEAM_OPENID_RETURN_URL=https://rizzotto.gg/auth/steam/return
# Optional, for persona/avatar enrichment
STEAM_WEB_API_KEY=

# ---- App-level ------------------------------------------------------------
FRONTEND_URL=https://rizzotto.gg
ARMY_LIST_UPLOAD_DIR=/var/lib/rizzotto/uploads
UPLOAD_DIR=/var/lib/rizzotto/uploads/army-lists-legacy
