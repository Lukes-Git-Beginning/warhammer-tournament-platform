# Caddy reverse-proxy + TLS terminator + SPA static server for rizzotto.gg.
# TLS via Cloudflare Origin Cert (15yr). Cloudflare proxies all traffic to this origin.
# Backend (Fastify + Socket.IO) runs on 127.0.0.1:3000 via systemd.
# Frontend (Vite build) is served directly from /home/deploy/rizzotto/apps/frontend/dist.

{
	admin off
	log {
		output stderr
		format json
		level INFO
	}
}

rizzotto.gg {
	tls /etc/rizzotto/secrets/cf-origin.pem /etc/rizzotto/secrets/cf-origin.key

	# Trust Cloudflare proxy IPs so X-Forwarded-For yields the real client IP.
	# Source: https://www.cloudflare.com/ips/ — refresh if needed.
	trusted_proxies static \
		173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
		197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
		104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
		2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
		2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	encode gzip zstd

	# Backend: API, Auth, GraphQL, WebSocket
	@backend path /api/* /auth/* /graphql /health /socket.io/*
	reverse_proxy @backend 127.0.0.1:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Long-lived caching for Vite content-hashed bundles
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Faction icons + textures (referenced by hash but stable)
	@static path /icons/* /img/* /textures/* /favicon.png /og-image.png
	header @static Cache-Control "public, max-age=86400"

	root * /home/deploy/rizzotto/apps/frontend/dist
	try_files {path} /index.html
	file_server
}
