[Unit]
Description=Rizzotto PostgreSQL backup (pg_dump | gzip, 14-day rotation, off-site copy)
Requires=docker.service
After=docker.service

# A backup that fails quietly is the worst kind. Report it the same way a failed backend is.
OnFailure=rizzotto-alert@%n.service

[Service]
Type=oneshot
User=deploy
# BACKUP_REMOTE + RCLONE_CONFIG_* (Cloudflare R2 credentials) live here, 0600 root:deploy.
# Missing file ⇒ local-only backup, which is still better than none.
EnvironmentFile=-/etc/rizzotto/env/backup.env
ExecStart=/home/deploy/rizzotto/scripts/backup-db.sh
