[Unit]
Description=Rizzotto backend health probe (restarts a wedged but "running" process)
After=rizzotto-backend.service

[Service]
Type=oneshot
# Needs root for `systemctl restart`; the probe itself is a plain local HTTP GET.
User=root
# Optional (leading "-"): without a webhook the watchdog still restarts a wedged backend and
# reports to the journal. A missing file must never stop the recovery path from running.
EnvironmentFile=-/etc/rizzotto/env/alert.env
ExecStart=/home/deploy/rizzotto/scripts/health-watchdog.sh
