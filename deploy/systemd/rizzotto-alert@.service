[Unit]
# Template unit fired via OnFailure=rizzotto-alert@%n.service. %i is the failed unit's name.
# Pairs with the health watchdog: this reports a unit systemd itself declared failed, the
# watchdog reports a unit that is "running" but no longer answering.
Description=Post a Discord alert about failed unit %i

[Service]
Type=oneshot
User=deploy
# ALERT_DISCORD_WEBHOOK lives here (0600, root:deploy). Same file the watchdog reads.
EnvironmentFile=/etc/rizzotto/env/alert.env
ExecStart=/usr/bin/env bash -c '\
  test -n "${ALERT_DISCORD_WEBHOOK:-}" || exit 0; \
  status=$(systemctl is-active %i 2>&1); \
  tail=$(journalctl -u %i -n 15 --no-pager -o cat 2>/dev/null | tail -c 1200); \
  jq -nc --arg unit "%i" --arg status "$status" --arg tail "$tail" \
    "{embeds:[{title:(\\"Unit failed — \\" + \$unit), color:15158332, fields:[{name:\\"State\\",value:\$status,inline:true}], description:(\\"\`\`\`\\" + \$tail + \\"\`\`\`\\")}]}" \
  | curl -sS -X POST "$ALERT_DISCORD_WEBHOOK" -H "Content-Type: application/json" -d @-'
