[Unit]
# Template unit fired via OnFailure=rizzotto-alert@%n.service. %i is the failed unit's name.
# Pairs with the health watchdog: this reports a unit systemd itself declared failed, the
# watchdog reports a unit that is "running" but no longer answering.
Description=Post a Discord alert about failed unit %i

[Service]
Type=oneshot
User=deploy
# ALERT_DISCORD_WEBHOOK lives here (0600, root:deploy). Same file the watchdog reads.
# Optional: with no webhook configured ExecStart exits 0 rather than failing the unit.
EnvironmentFile=-/etc/rizzotto/env/alert.env
ExecStart=/home/deploy/rizzotto/scripts/notify-unit-failure.sh %i
