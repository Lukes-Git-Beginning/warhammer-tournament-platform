# =============================================================================
# TWW3 Tournament Platform — Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Railway provides production values via plugin auto-injection.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---- Database (PostgreSQL) --------------------------------------------------
# Local: matches docker-compose.yml. Railway injects DATABASE_URL automatically.
DATABASE_URL=postgresql://tww3:tww3@localhost:5432/tww3?schema=public

# ---- Redis ------------------------------------------------------------------
# Used for Socket.io adapter + draft timer state (M4).
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) -------------------------------------------------------------
# Generate: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_COOKIE_NAME=auth_token
JWT_COOKIE_DOMAIN=localhost
# 7 days in seconds
JWT_EXPIRES_IN=604800

# ---- Discord OAuth2 ---------------------------------------------------------
# Create app at https://discord.com/developers/applications
# Redirect URI must match exactly: {BACKEND_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Scopes (space-separated): identify gets username+avatar, email is optional
DISCORD_SCOPES=identify email

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info
