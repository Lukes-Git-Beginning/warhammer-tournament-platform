# =============================================================================
# TWW3 Tournament Platform — Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Railway provides production values via plugin auto-injection.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---- Database (PostgreSQL) --------------------------------------------------
# Local: matches docker-compose.yml. Railway injects DATABASE_URL automatically.
DATABASE_URL=postgresql://tww3:tww3@localhost:5432/tww3?schema=public

# ---- Redis ------------------------------------------------------------------
# Used for Socket.io adapter + draft timer state (M4).
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) -------------------------------------------------------------
# Generate: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_COOKIE_NAME=auth_token
JWT_COOKIE_DOMAIN=localhost
# 7 days in seconds
JWT_EXPIRES_IN=604800

# ---- Discord OAuth2 ---------------------------------------------------------
# Create app at https://discord.com/developers/applications
# Redirect URI must match exactly: {BACKEND_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Scopes (space-separated): identify gets username+avatar, email is optional
# guilds.join is needed to auto-add users to the RizzOttoverse Discord server on login
DISCORD_SCOPES=identify email guilds.join

# ---- Discord Bot (Notifications + Guild Management — optional) ---------------
# Create a Bot application at https://discord.com/developers/applications
# Requires MESSAGE_CONTENT and DIRECT_MESSAGES intents
# If not set, all Discord notification functions skip silently
DISCORD_BOT_TOKEN=
# RizzOttoverse Discord server ID — right-click server icon → Copy Server ID (Developer Mode)
# Required for auto-adding users to the server on login (needs guilds.join scope above)
DISCORD_GUILD_ID=

# ---- Steam OpenID 2.0 -------------------------------------------------------
# Return URL must be publicly reachable (or localhost for dev with ngrok etc.)
STEAM_OPENID_RETURN_URL=http://localhost:3000/auth/steam/return
# Optional: fetch persona/avatar from Steam Web API after login
# Create key at https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# ---- Army List Storage -------------------------------------------------------
# Directory for tournament army list uploads. Defaults to <cwd>/storage/army-lists
# ARMY_LIST_UPLOAD_DIR=/app/storage/army-lists

# ---- Announcements (AI-generated tournament copy — optional) ----------------
# Anthropic API key. If unset, the Admin "Announcements" tab still manages
# destinations, but generation returns 503 "not configured".
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the generation model (defaults to claude-sonnet-4-6). Point this at
# a newer/cheaper Sonnet once its exact model ID is confirmed — no code change needed.
# ANNOUNCEMENT_MODEL=claude-sonnet-4-6

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info
