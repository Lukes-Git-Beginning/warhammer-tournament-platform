// =============================================================================
// Rizzotto — Database Schema
// Phase 1+2 complete (M1+M2 use). Draft/Stats/Snapshot models are reserved here
// to avoid late migrations during M3/M4. See ROADMAP.md and plan file.
// Welle 2 (Plan 2 + Plan 3): Map-Pool, Match-Decision, Blind-Pick, Army-Lists,
// Steam-Link, FactionMastery, FactionMatchupStat, AntiFarmCap, AdminConfig.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  USER
  ORGANIZER
  MODERATOR
  ADMIN
}

enum TournamentFormat {
  SWISS
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
  LIECHTENSTEIN
}

enum TournamentMode {
  ONE_V_ONE // legacy 1v1
  THREE_V_THREE // reserved for Phase 3
  BLIND_PICK // reserved for Phase 3
  BPT // Blind Pick Tournament — every match has blind faction pick
  SFT // Single Faction Tournament — faction pre-pick at registration
  SLT // Single List Tournament — army list pre-upload at registration
}

enum PlayoffFormat {
  NONE
  TOP4
  TOP8
}

enum MatchFormat {
  BO1
  BO3
  BO5
}

enum MapDecisionMode {
  RANDOM               // legacy
  PICK_BAN             // legacy
  RANDOM_NO_REPEAT     // a: zufällig, kein Repeat im Match + turnierweit
  HOST_PRESET          // b: Organizer legt Maps pro Runde in Reihenfolge fest
  HOST_PRESET_PICK_BAN // c: Organizer legt 3 Maps pro Runde/Game fest, dann Ban→Pick
  RANDOM_PICK_BAN      // d: Server zieht 3 Maps pro Game (No-Repeat), dann Ban→Pick
}

enum TournamentStatus {
  DRAFT
  OPEN_REGISTRATION
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
}

enum ParticipantStatus {
  REGISTERED
  CHECKED_IN
  DISQUALIFIED
  WITHDREW
}

enum MatchStatus {
  PENDING
  ONGOING
  COMPLETED
  BYE // system-generated walkover (odd participant count)
  FORFEIT // organizer-triggered (no-show / DQ)
  DISPUTED // Q4: dual-submit conflict, awaiting organizer/admin override
}

enum MatchResultType {
  PLAYER1_WIN
  PLAYER2_WIN
  DRAW
  DOUBLE_LOSS
}

enum BracketSide {
  WINNERS
  LOSERS
  GRAND_FINAL
}

enum MatchPhase {
  GROUP_STAGE // reserved for future team-league formats
  SWISS // Swiss rounds
  PLAYOFF_QF // Quarter-Final
  PLAYOFF_SF // Semi-Final
  PLAYOFF_FINAL // Grand Final
  PLAYOFF_THIRD_PLACE // Third-place match (losers of semis)
}

enum FactionCategory {
  ORDER
  DESTRUCTION
  CHAOS_GODS
  UNDEAD
  DEFAULT
}

enum ArmyListFileType {
  ARMY_SETUP // .army_setup binary export
  SCREENSHOT
  TXT // plain-text army list (M5.4 upload)
  PDF // PDF army list (M5.4 upload)
}

enum DraftStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Core: Users
// -----------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  discord_id         String    @unique
  username           String
  email              String?
  avatar_url         String?
  timezone           String? // IANA, e.g. "Europe/Berlin"
  role               Role      @default(USER)
  preferred_factions String[]  @default([])
  last_login         DateTime?
  onboarded_at       DateTime?
  onboarding_stage   Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  // Organizer relations
  organized_tournaments Tournament[]  @relation("OrganizedTournaments")
  created_draft_presets DraftPreset[] @relation("CreatedDraftPresets")

  // Player relations
  participations        TournamentParticipant[]
  matches_as_player1    Match[]                 @relation("MatchPlayer1")
  matches_as_player2    Match[]                 @relation("MatchPlayer2")
  matches_won           Match[]                 @relation("MatchWinner")
  army_lists            ArmyList[]
  tournament_army_lists TournamentArmyList[]
  leaderboard_entries   LeaderboardEntry[]
  tournament_results    TournamentResult[]
  captained_teams       Team[]                  @relation("TeamCaptain")
  team_memberships      TeamMember[]
  audit_logs            AuditLog[]              @relation("AuditActor")
  match_reports         MatchReport[]           @relation("MatchReportReporter")
  // Welle 2
  steam_link            SteamLink?
  // External (TT archive)
  external_games_as_p1  ExternalGame[]          @relation("ExternalGamePlayer1")
  external_games_as_p2  ExternalGame[]          @relation("ExternalGamePlayer2")
  external_games_won    ExternalGame[]          @relation("ExternalGameWinner")

  @@index([role])
  @@index([deleted_at])
}

// -----------------------------------------------------------------------------
// Reference: Factions (seeded, 24 entries)
// -----------------------------------------------------------------------------

model Faction {
  id            String          @id // slug, e.g. "high_elves"
  name          String
  race          String
  category      FactionCategory
  color_hex     String
  display_order Int             @unique // 1..24, drives heatmap row/col order
  icon_url      String? // populated in M5 polish
  game_id       String? // optional external TWW3 internal id
  created_at    DateTime        @default(now())

  // Reverse relations
  tournament_allowlists      TournamentFactionAllowlist[]
  participants               TournamentParticipant[]
  matches_as_player1_faction Match[]                      @relation("MatchPlayer1Faction")
  matches_as_player2_faction Match[]                      @relation("MatchPlayer2Faction")
  army_lists                 ArmyList[]
  stats                      FactionStats[]
  stats_snapshots            FactionStatsSnapshot[]
  matchups_as_a              MatchupStats[]               @relation("MatchupFactionA")
  matchups_as_b              MatchupStats[]               @relation("MatchupFactionB")
  // External (TT archive)
  external_games_as_f1       ExternalGame[]               @relation("ExternalGameFaction1")
  external_games_as_f2       ExternalGame[]               @relation("ExternalGameFaction2")

  @@index([category])
}

// -----------------------------------------------------------------------------
// Tournament + Registration
// -----------------------------------------------------------------------------

model Tournament {
  id                     String               @id @default(uuid()) @db.Uuid
  slug                   String               @unique
  name                   String
  description            String?
  poster_url             String?
  organizer_id           String               @db.Uuid
  format                 TournamentFormat
  mode                   TournamentMode       @default(BPT)
  status                 TournamentStatus     @default(DRAFT)
  visibility             TournamentVisibility @default(PUBLIC)
  max_participants       Int?
  start_date             DateTime
  timezone               String // IANA
  registration_deadline  DateTime?
  rules                  String               @default("") // markdown
  discord_link           String?
  entry_fee              String? // free-text
  draft_enabled          Boolean              @default(false)
  draft_preset_id        String?              @db.Uuid
  counts_for_leaderboard Boolean              @default(true)
  is_major               Boolean              @default(false)
  // Welle 2 — Tournament-Mechanik
  rounds_count           Int                  @default(5) // 3–6 via constraint
  has_third_place_match  Boolean              @default(false)
  playoff_format         PlayoffFormat        @default(NONE)
  swiss_match_format     MatchFormat          @default(BO1)
  playoff_match_format   MatchFormat          @default(BO1) // Bo3/Bo5 re-enable with series support
  finale_match_format    MatchFormat          @default(BO1)
  map_decision_mode      MapDecisionMode      @default(PICK_BAN)
  map_preset_config      Json?                // HOST_PRESET / HOST_PRESET_PICK_BAN: runden-spez. Map-Konfiguration
  random_map_pool_played String[]             @default([]) // RANDOM_NO_REPEAT / RANDOM_PICK_BAN: turnierweit gespielte Maps
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  deleted_at             DateTime?

  // Relations
  organizer             User                         @relation("OrganizedTournaments", fields: [organizer_id], references: [id])
  draft_preset          DraftPreset?                 @relation(fields: [draft_preset_id], references: [id])
  faction_allowlist     TournamentFactionAllowlist[]
  participants          TournamentParticipant[]
  matches               Match[]
  teams                 Team[]
  results               TournamentResult[]
  major_for_seasons     Season[]                     @relation("SeasonMajor")
  map_pool              TournamentMapPool[]
  tournament_army_lists TournamentArmyList[]

  @@index([status])
  @@index([organizer_id])
  @@index([start_date])
  @@index([deleted_at])
}

// Empty allowlist => all factions allowed.
model TournamentFactionAllowlist {
  tournament_id String @db.Uuid
  faction_id    String

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  faction    Faction    @relation(fields: [faction_id], references: [id])

  @@id([tournament_id, faction_id])
  @@index([tournament_id])
}

model TournamentParticipant {
  id              String            @id @default(uuid()) @db.Uuid
  tournament_id   String            @db.Uuid
  user_id         String            @db.Uuid
  team_id         String?           @db.Uuid // null for 1v1 (Phase 1+2)
  faction_id      String? // pre-pick at registration (SFT mode) or post-draft
  army_list_id    String?           @db.Uuid
  status          ParticipantStatus @default(REGISTERED)
  registered_at   DateTime          @default(now())
  lists_locked_at DateTime? // Q3: after organizer locks lists, army_list_id becomes immutable
  deleted_at      DateTime?

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id])
  team       Team?      @relation(fields: [team_id], references: [id])
  faction    Faction?   @relation(fields: [faction_id], references: [id])
  army_list  ArmyList?  @relation(fields: [army_list_id], references: [id])

  @@unique([tournament_id, user_id])
  @@index([tournament_id, status])
  @@index([user_id])
}

// -----------------------------------------------------------------------------
// Match (with self-reference for bracket traversal)
// -----------------------------------------------------------------------------

model Match {
  id                  String           @id @default(uuid()) @db.Uuid
  tournament_id       String           @db.Uuid
  round               Int
  match_number        Int
  player1_id          String?          @db.Uuid
  player2_id          String?          @db.Uuid
  winner_id           String?          @db.Uuid
  score               String? // DEPRECATED in favour of `result` + points; kept for backwards-read of historical rows
  result              MatchResultType? // Q12: structured outcome
  player1_points      Float? // Q12: 1.0 / 0.5 / 0.0 for Swiss, 3 / 1 / 0 for round-based scoring
  player2_points      Float?
  status              MatchStatus      @default(PENDING)
  scheduled_time      DateTime?
  next_match_id       String?          @db.Uuid
  loser_next_match_id String?          @db.Uuid // DE: where the losing player drops to in lower bracket (NULL for SE/Swiss)
  bracket_side        BracketSide? // DE: WINNERS / LOSERS / GRAND_FINAL (NULL for SE/Swiss/RR)
  phase               MatchPhase? // Welle 2: discriminator between Swiss/Playoff phases (NULL = legacy/SE/RR)
  player1_faction_id  String?
  player2_faction_id  String?
  // Dynamic weighted leaderboard (derive-on-read): authoritative season tag +
  // play time, stamped when the match is completed. season_id is nullable so it
  // is only set for finished matches (backfilled for historical rows).
  season_id           String?          @db.Uuid
  played_at           DateTime? // set when status flips to COMPLETED
  ruleset             String? // optional patch / ruleset identifier
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  deleted_at          DateTime?

  tournament       Tournament        @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  season           Season?           @relation(fields: [season_id], references: [id])
  player1          User?             @relation("MatchPlayer1", fields: [player1_id], references: [id])
  player2          User?             @relation("MatchPlayer2", fields: [player2_id], references: [id])
  winner           User?             @relation("MatchWinner", fields: [winner_id], references: [id])
  next_match       Match?            @relation("BracketProgression", fields: [next_match_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeder_matches   Match[]           @relation("BracketProgression")
  loser_next_match Match?            @relation("LoserBracketProgression", fields: [loser_next_match_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  losers_feeder    Match[]           @relation("LoserBracketProgression")
  player1_faction  Faction?          @relation("MatchPlayer1Faction", fields: [player1_faction_id], references: [id])
  player2_faction  Faction?          @relation("MatchPlayer2Faction", fields: [player2_faction_id], references: [id])
  draft            Draft?
  reports          MatchReport[]
  games            MatchGame[]

  @@unique([tournament_id, round, match_number])
  @@index([tournament_id, status])
  @@index([season_id, status])
  @@index([player1_id])
  @@index([player2_id])
  @@index([deleted_at])
}

// M7: MatchGame — one row per Battle in a Match (Bo1=1 game, Bo3=up to 3, Bo5=up to 5).
// v1: always game_number=1 (Bo1 only). Schema is series-ready for Bo3/Bo5.
model MatchGame {
  id                 String      @id @default(uuid()) @db.Uuid
  match_id           String      @db.Uuid
  game_number        Int         @default(1)
  status             MatchStatus @default(PENDING)
  winner_id          String?     @db.Uuid
  player1_faction_id String?     // auto-resolved from BlindPick/SFT on finalization
  player2_faction_id String?
  lobby_code         String?     // optional ingame lobby code
  // Provisional-result flow (30-min auto-confirm)
  reported_winner_id String?     @db.Uuid
  reporter_id        String?     @db.Uuid
  reported_at        DateTime?
  confirmed_at       DateTime?   // set on opponent-confirm OR cron auto-confirm
  replay_url             String?     // required on first report (anti-farming)
  played_at              DateTime?
  counts_for_leaderboard Boolean     @default(true)
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  match        Match             @relation(fields: [match_id], references: [id], onDelete: Cascade)
  map_decision MatchMapDecision?
  blind_pick   MatchBlindPick?

  @@unique([match_id, game_number])
  @@index([match_id])
  @@index([reported_at]) // cron scan for auto-confirm
}

// Welle 2: Map decision (coin-flip, pick/ban) per game.
model MatchMapDecision {
  game_id          String          @id @db.Uuid
  mode             MapDecisionMode
  coin_flip_seed   String
  top_player_id    String          @db.Uuid
  bottom_player_id String          @db.Uuid
  bans_top         String[] // Map IDs banned by top player
  bans_bottom      String[] // Map IDs banned by bottom player
  active_pool      String[]        @default([]) // HOST_PRESET_PICK_BAN / RANDOM_PICK_BAN: aktive 3 Maps für dieses Game
  picked_map_id    String? // final picked Map ID
  decided_at       DateTime?

  game MatchGame @relation(fields: [game_id], references: [id], onDelete: Cascade)
}

// Welle 2: Blind faction pick per game (BPT mode).
model MatchBlindPick {
  game_id            String    @id @db.Uuid
  player1_faction_id String?
  player2_faction_id String?
  player1_locked_at  DateTime?
  player2_locked_at  DateTime?
  revealed_at        DateTime?

  game MatchGame @relation(fields: [game_id], references: [id], onDelete: Cascade)
}

// Q4: Dual-submit match reports. Each player submits their own report; agreement
// completes the match, disagreement flips status to DISPUTED for organizer review.
model MatchReport {
  id            String          @id @default(uuid()) @db.Uuid
  match_id      String          @db.Uuid
  reporter_id   String          @db.Uuid
  result        MatchResultType
  player1_score Int? // optional raw VP / battle points for organizer context
  player2_score Int?
  notes         String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  match    Match @relation(fields: [match_id], references: [id], onDelete: Cascade)
  reporter User  @relation("MatchReportReporter", fields: [reporter_id], references: [id])

  @@unique([match_id, reporter_id])
  @@index([match_id])
}

// -----------------------------------------------------------------------------
// Team (stubs for 3v3, Phase 3 — unused in M1-M3)
// -----------------------------------------------------------------------------

model Team {
  id            String   @id @default(uuid()) @db.Uuid
  tournament_id String   @db.Uuid
  name          String
  captain_id    String   @db.Uuid
  created_at    DateTime @default(now())

  tournament   Tournament              @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  captain      User                    @relation("TeamCaptain", fields: [captain_id], references: [id])
  members      TeamMember[]
  participants TournamentParticipant[]

  @@index([tournament_id])
}

model TeamMember {
  id      String  @id @default(uuid()) @db.Uuid
  team_id String  @db.Uuid
  user_id String  @db.Uuid
  role    String? // e.g. "captain", "core", "sub" — unused in M1

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
}

// -----------------------------------------------------------------------------
// Season + Leaderboard
// -----------------------------------------------------------------------------

model Season {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  start_date          DateTime
  end_date            DateTime
  is_active           Boolean  @default(false)
  dlc_tag             String?
  major_tournament_id String?  @db.Uuid
  created_at          DateTime @default(now())

  major_tournament Tournament?            @relation("SeasonMajor", fields: [major_tournament_id], references: [id])
  matches          Match[]
  leaderboard      LeaderboardEntry[]
  results          TournamentResult[]
  faction_stats    FactionStats[]
  matchup_stats    MatchupStats[]
  stats_snapshots  FactionStatsSnapshot[]

  @@index([is_active])
  @@index([start_date])
}

model LeaderboardEntry {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  season_id    String   @db.Uuid
  total_points Float    @default(0)
  games_played Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [id])
  season Season @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@unique([user_id, season_id])
  @@index([season_id, total_points(sort: Desc)])
}

model TournamentResult {
  id            String   @id @default(uuid()) @db.Uuid
  tournament_id String   @db.Uuid
  user_id       String   @db.Uuid
  season_id     String?  @db.Uuid // null if tournament not counted for leaderboard
  placement     Int
  points_earned Float    @default(0)
  created_at    DateTime @default(now())

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id])
  season     Season?    @relation(fields: [season_id], references: [id])

  @@unique([tournament_id, user_id])
  @@index([user_id])
  @@index([season_id])
}

// -----------------------------------------------------------------------------
// Maps (Welle 2 — master pool, admin-managed)
// -----------------------------------------------------------------------------

model Map {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image_url   String?
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tournament_pools TournamentMapPool[]

  @@index([deleted_at])
}

// Snapshot of maps assigned to a tournament at creation time.
// Isolates tournament from later global pool changes.
model TournamentMapPool {
  tournament_id String @db.Uuid
  map_id        String

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  map        Map        @relation(fields: [map_id], references: [id])

  @@id([tournament_id, map_id])
  @@index([tournament_id])
}

// -----------------------------------------------------------------------------
// Tournament Army Lists (Welle 2 — SLT mode, per-tournament per-user)
// Composite PK tournament_id + user_id (one list per player per tournament).
// Separate from the legacy ArmyList (per-faction upload, M5).
// -----------------------------------------------------------------------------

model TournamentArmyList {
  tournament_id            String    @db.Uuid
  user_id                  String    @db.Uuid
  file_url                 String? // .army_setup binary
  screenshot_url           String // primary proof screenshot
  parsed_json              Json?
  locked_at                DateTime?
  revealed_to_opponents_at DateTime?
  revealed_publicly_at     DateTime?

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id])

  @@id([tournament_id, user_id])
  @@index([user_id])
}

// -----------------------------------------------------------------------------
// Steam Link (Welle 2 — required gate post-Discord-login)
// -----------------------------------------------------------------------------

model SteamLink {
  user_id     String   @unique @db.Uuid
  steam_id    String   @unique
  persona     String
  avatar_url  String?
  profile_url String?
  verified_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Army Lists (M5 implementation, schema reserved here)
// -----------------------------------------------------------------------------

model ArmyList {
  id            String           @id @default(uuid()) @db.Uuid
  user_id       String           @db.Uuid
  tournament_id String?          @db.Uuid
  faction_id    String
  file_url      String
  file_name     String
  file_type     ArmyListFileType
  parsed_data   Json? // { battle_type, lord, units }
  created_at    DateTime         @default(now())

  user         User                    @relation(fields: [user_id], references: [id])
  faction      Faction                 @relation(fields: [faction_id], references: [id])
  participants TournamentParticipant[]

  @@index([user_id])
  @@index([tournament_id])
}

// -----------------------------------------------------------------------------
// Faction Stats (M3 implementation, schema reserved here)
// -----------------------------------------------------------------------------

model FactionStats {
  id             String   @id @default(uuid()) @db.Uuid
  faction_id     String
  season_id      String   @db.Uuid
  matches_played Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  draws          Int      @default(0)
  pick_count     Int      @default(0)
  ban_count      Int      @default(0)
  updated_at     DateTime @updatedAt

  faction Faction @relation(fields: [faction_id], references: [id])
  season  Season  @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@unique([faction_id, season_id])
  @@index([season_id])
}

// Daily snapshot table to support winrate_trend rolling-30d (M3).
model FactionStatsSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  faction_id     String
  season_id      String   @db.Uuid
  snapshot_date  DateTime @db.Date
  matches_played Int
  wins           Int
  losses         Int
  draws          Int
  pick_count     Int
  ban_count      Int
  created_at     DateTime @default(now())

  faction Faction @relation(fields: [faction_id], references: [id])
  season  Season  @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@unique([faction_id, season_id, snapshot_date])
  @@index([faction_id, season_id])
  @@index([snapshot_date])
}

// 24x24 matchup heatmap source (M3).
model MatchupStats {
  id             String   @id @default(uuid()) @db.Uuid
  faction_a_id   String
  faction_b_id   String
  season_id      String   @db.Uuid
  faction_a_wins Int      @default(0)
  faction_b_wins Int      @default(0)
  draws          Int      @default(0)
  updated_at     DateTime @updatedAt

  faction_a Faction @relation("MatchupFactionA", fields: [faction_a_id], references: [id])
  faction_b Faction @relation("MatchupFactionB", fields: [faction_b_id], references: [id])
  season    Season  @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@unique([faction_a_id, faction_b_id, season_id])
  @@index([season_id])
}

// -----------------------------------------------------------------------------
// Draft System (M4 implementation, schema reserved here)
// -----------------------------------------------------------------------------

model DraftPreset {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  created_by      String   @db.Uuid
  is_public       Boolean  @default(false)
  category_limits Json     @default("[]") // array of { category_name, factions[], max_picks, max_bans }
  turns           Json     @default("[]") // ordered array of pick/ban/snipe/steal/reveal actions
  turn_seconds    Int      @default(30)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  creator     User         @relation("CreatedDraftPresets", fields: [created_by], references: [id])
  tournaments Tournament[]
  drafts      Draft[]

  @@index([is_public])
  @@index([created_by])
}

model Draft {
  id                   String      @id @default(uuid()) @db.Uuid
  match_id             String      @unique @db.Uuid
  preset_id            String      @db.Uuid
  status               DraftStatus @default(PENDING)
  current_turn         Int         @default(0)
  state                Json        @default("{}") // DraftState shape — see packages/types/src/draft.ts
  timer_expires_at     DateTime?
  host_user_id         String?     @db.Uuid // populated at startDraft (= match.player1_id)
  guest_user_id        String?     @db.Uuid // populated at startDraft (= match.player2_id)
  first_pick_user_id   String?     @db.Uuid // Q1: coin-flip winner persisted at draft start
  completed_at         DateTime?
  final_host_factions  String[]    @default([])
  final_guest_factions String[]    @default([])
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  match  Match        @relation(fields: [match_id], references: [id], onDelete: Cascade)
  preset DraftPreset  @relation(fields: [preset_id], references: [id])
  events DraftEvent[]

  @@index([status])
  @@index([host_user_id])
  @@index([guest_user_id])
}

model DraftEvent {
  id               String   @id @default(uuid()) @db.Uuid
  draft_id         String   @db.Uuid
  turn_index       Int
  actor            String // 'host' | 'guest' | 'admin' | 'system'
  action           String // 'pick' | 'ban' | 'snipe' | 'steal' | 'reveal_picks' | 'reveal_bans' | 'reveal_all' | 'auto_select' | 'start' | 'complete' | 'cancel'
  faction_id       String?
  is_auto_selected Boolean  @default(false)
  payload          Json? // free-form (as_opponent target, revealed list, etc.)
  created_at       DateTime @default(now())

  draft Draft @relation(fields: [draft_id], references: [id], onDelete: Cascade)

  @@index([draft_id, turn_index])
  @@index([created_at])
}

// -----------------------------------------------------------------------------
// Audit Log (M5 admin panel, schema reserved here)
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entity_type String // "Tournament", "Match", "User", ...
  entity_id   String // stringified (UUID or slug)
  action      String // "create", "update", "delete", "status_change", "result_report", ...
  actor_id    String?  @db.Uuid // null for system actions
  old_value   Json?
  new_value   Json?
  created_at  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actor_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@index([created_at])
}

// -----------------------------------------------------------------------------
// Scraper: Import Log (M5.3 — records each scraper run for observability)
// -----------------------------------------------------------------------------

model ImportLog {
  id               String    @id @default(uuid()) @db.Uuid
  source           String // "totaltavern_factions" | "totaltavern_tournament"
  status           String // "success" | "partial" | "error"
  records_imported Int       @default(0)
  error_message    String?
  started_at       DateTime  @default(now())
  finished_at      DateTime?

  @@index([source, started_at])
}

// -----------------------------------------------------------------------------
// External Game Archive (TT scrape — player-name strings + best-effort FK resolve)
// Resolved FKs (player1_id etc.) start as null and are populated on user
// registration via the auth callback reconciliation hook.
// -----------------------------------------------------------------------------

model ExternalGame {
  id                     String   @id @default(uuid()) @db.Uuid
  source                 String   @default("totaltavern")
  external_tournament_id Int
  round                  Int      @default(0)
  score                  String?

  // Raw strings — always populated
  player1_name           String
  player2_name           String
  player1_faction_name   String?
  player2_faction_name   String?
  winner_name            String?  // null = Draw / no result

  // Resolved FKs — nullable, populated on user registration
  player1_id             String?  @db.Uuid
  player2_id             String?  @db.Uuid
  winner_id              String?  @db.Uuid
  player1_faction_id     String?
  player2_faction_id     String?

  scraped_at             DateTime @default(now())

  player1         User?    @relation("ExternalGamePlayer1",   fields: [player1_id],        references: [id])
  player2         User?    @relation("ExternalGamePlayer2",   fields: [player2_id],        references: [id])
  winner          User?    @relation("ExternalGameWinner",    fields: [winner_id],          references: [id])
  player1_faction Faction? @relation("ExternalGameFaction1", fields: [player1_faction_id], references: [id])
  player2_faction Faction? @relation("ExternalGameFaction2", fields: [player2_faction_id], references: [id])

  @@unique([source, external_tournament_id, round, player1_name, player2_name])
  @@index([player1_id])
  @@index([player2_id])
  @@index([player1_faction_id, player2_faction_id])
}

// -----------------------------------------------------------------------------
// Admin Config (Welle 2 — Plan 3 Live-Settings)
// Generic key-value store for admin-configurable settings.
// -----------------------------------------------------------------------------

model AdminConfig {
  key        String   @id
  value      Json
  updated_by String? // discord_id or null for system
  updated_at DateTime @updatedAt
}
